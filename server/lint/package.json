  "description": "Lints one pasted React/TypeScript snippet with ESLint's Linter API. JSON on stdin, JSON on stdout.",
  "scripts": {
    "lint-snippet": "node lint-snippet.mjs"
  },
  "dependencies": {
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
