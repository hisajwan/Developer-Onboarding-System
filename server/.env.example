ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# fake needs no keys and no network (default). Real providers: gemini | groq | openrouter (embeddings/captions: gemini)
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake
CAPTION_PROVIDER=fake
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Login: one user, checked on the server. Pick your own values; login stays off while these are empty.
# Make a signing secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
AUTH_SECRET=your_secret_key_here
SESSION_TTL_MINUTES=480

DATA_DIR=data
