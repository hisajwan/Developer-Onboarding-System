ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# fake needs no keys and no network (default). Real providers: gemini | groq | openrouter (embeddings/captions: gemini)
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake
CAPTION_PROVIDER=fake
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Login: accounts live in the users table, not here. Create one with `python scripts/create_user.py`
# (from server/, venv active). Make a signing secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=your_secret_key_here
SESSION_TTL_MINUTES=480

DATA_DIR=data
