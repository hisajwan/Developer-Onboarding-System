ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# fake needs no keys and no network (default). Real: gemini (all three). groq | openrouter are not implemented yet.
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake
CAPTION_PROVIDER=fake
GEMINI_API_KEY=
# Gemini models: pick ones your key has free quota for (https://aistudio.google.com/rate-limit).
# The fallback model is tried when the main one is rate-limited; leave it empty to disable.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Login: accounts live in the users table, not here. Create one with `python scripts/create_user.py`
# (from server/, venv active). Make a signing secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=your_secret_key_here
SESSION_TTL_MINUTES=480

DATA_DIR=data
